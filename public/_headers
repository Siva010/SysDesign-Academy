# Cloudflare Pages reads this file from the build output root.
# Rules are matched most-specific first; each block applies to paths matching its pattern.

# Build assets carry a content hash in the filename, so a changed asset is a different URL.
# Nothing here can go stale, which is what makes a one-year immutable lifetime correct
# rather than optimistic.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The search index is rebuilt on every deploy and is not content-hashed, so it needs a short
# lifetime with revalidation. Five minutes keeps a deploy visible quickly without making the
# first search on every page load a full download.
/search-index.json
  Cache-Control: public, max-age=300, must-revalidate

# HTML is cheap to revalidate and must never be served stale after a deploy, because a stale
# document can reference asset URLs that no longer exist.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
